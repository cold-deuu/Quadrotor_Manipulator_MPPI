<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="franka_gazebo" params="command_interface:=EffortJointInterface">


    <!-- 각 조인트에 transmission 설정 -->
    <transmission name="panda_joint1">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="panda_joint1">
        <hardwareInterface>hardware_interface/${command_interface}</hardwareInterface>
      </joint>
      <actuator name="panda_joint1">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="panda_joint2">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="panda_joint2">
        <hardwareInterface>hardware_interface/${command_interface}</hardwareInterface>
      </joint>
      <actuator name="panda_joint2">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="panda_joint3">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="panda_joint3">
        <hardwareInterface>hardware_interface/${command_interface}</hardwareInterface>
      </joint>
      <actuator name="panda_joint3">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="panda_joint4">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="panda_joint4">
        <hardwareInterface>hardware_interface/${command_interface}</hardwareInterface>
      </joint>
      <actuator name="panda_joint4">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="panda_joint5">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="panda_joint5">
        <hardwareInterface>hardware_interface/${command_interface}</hardwareInterface>
      </joint>
      <actuator name="panda_joint5">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="panda_joint6">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="panda_joint6">
        <hardwareInterface>hardware_interface/${command_interface}</hardwareInterface>
      </joint>
      <actuator name="panda_joint6">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="panda_joint7">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="panda_joint7">
        <hardwareInterface>hardware_interface/${command_interface}</hardwareInterface>
      </joint>
      <actuator name="panda_joint7">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

  </xacro:macro>
</robot>